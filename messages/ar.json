      { "title": "\u0627\u0644\u062a\u0648\u0632\u064a\u0639 \u0648\u0627\u0644\u062a\u0633\u0644\u064a\u0645", "description": "\u062a\u0633\u0644\u064a\u0645 \u0633\u0631\u064a\u0639 \u0648\u0645\u0648\u062b\u0648\u0642 \u0644\u0644\u0645\u0628\u064a\u0639\u064a\u0646 \u0648\u0627\u0644\u0634\u0631\u0643\u0627\u062a \u0641\u064a \u062c\u0645\u064a\u0639 \u0627\u0644\u0645\u062d\u0627\u0641\u0638\u0627\u062a \u0627\u0644\u062b\u0645\u0627\u0646\u064a\u0629 \u0627\u0644\u062e\u0645\u0633\u064a\u0646\u0629." },
      { "title": "\u0627\u0644\u062f\u0639\u0645 \u0627\u0644\u0645\u0633\u062a\u0645\u0631", "description": "\u0625\u062f\u0627\u0631\u0629 \u062d\u0633\u0627\u0628\u0627\u062a \u0645\u0633\u062a\u0645\u0631\u0629\u060c \u0645\u0639\u0627\u0648\u0646\u0629 \u0641\u0646\u064a\u0629\u060c \u0648\u062a\u0642\u0631\u064a\u0631 \u0627\u0644\u0623\u062f\u0627\u0621." }
