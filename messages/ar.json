  "faq": {
    "badge": "\u0627\u0644\u0623\u0633\u0626\u0644\u0629 \u0627\u0644\u0634\u0627\u0626\u0639\u0629",
    "title": "\u0627\u0644\u0623\u0633\u0626\u0644\u0629 \u0627\u0644\u0645\u0637\u0631\u0648\u062d \u0628\u0639\u062f",
    "subtitle": "\u0627\u0644\u0625\u062c\u0627\u0628\u0627\u062a \u0639\u0646 \u0627\u0644\u0623\u0633\u0626\u0644\u0629 \u0627\u0644\u0634\u0627\u0626\u0639\u0629 \u062d\u0648\u0644 \u062e\u062f\u0645\u0627\u062a \u062a\u0648\u0632\u064a\u0639 \u0634\u062d\u0646 \u0627\u0644\u062a\u062d\u0645\u064a\u0644 \u0648\u062a\u0648\u0632\u064a\u0639 \u0628\u0637\u0627\u0642\u0627\u062a \u0627\u0644\u0627\u062a\u0635\u0627\u0644.",
    "items": [
      { "q": "\u0643\u064a\u0641 \u0623\u0635\u0628\u062d \u0645\u0648\u0627\u0642\u0639\u0627\u064b \u0644\u0633\u0648\u0642 STI\u061f", "a": "\u062a\u0633\u062c\u064a\u0644 \u0645\u0648\u0627\u0642\u0639 STI \u0628\u0633\u0647\u0644. \u0627\u062a\u0635\u0644 \u0628\u0641\u0631\u064a\u0642 \u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a \u0644\u0644\u062a\u0642\u062f\u064a\u0645 \u0639\u0644\u0649 \u0634\u0631\u0643\u0629. \u0646\u062d\u0646 \u0646\u0642\u062f\u0645 \u0633\u0639\u0631 \u062c\u0633\u0645\u064a\u0627\u064b \u0645\u0646\u0627\u0641\u0635\u064a\u064b\u060c \u062a\u0648\u0641\u0631 \u0645\u0648\u062b\u0648\u0642 \u0644\u0644\u0645\u0646\u062a\u062c\u0627\u062a \u0648\u062f\u0639\u0645 \u0645\u0633\u062a\u0645\u0631 \u0644\u0644\u0645\u0628\u064a\u0639\u064a\u0646 \u0648\u0627\u0644\u0645\u0648\u0627\u0642\u0639\u064a\u0646 \u0627\u0644\u0645\u062e\u0635\u0635\u064a\u0646 \u0641\u064a \u062c\u0632\u0627\u0626\u0631 \u0627\u0644\u0639\u062c\u0645\u0631." },
      { "q": "\u0645\u0627 \u0647\u064a \u0627\u0644\u0645\u0646\u062a\u062c\u0627\u062a \u0627\u0644\u062a\u064a \u062a\u0648\u0632\u0639\u0647\u0627 STI\u061f", "a": "\u062a\u062a\u062e\u0635\u0635 STI \u0641\u064a \u062a\u0648\u0632\u064a\u0639 \u0634\u062d\u0646 \u0627\u0644\u062a\u062d\u0645\u064a\u0644 \u0627\u0644\u0645\u0648\u0627\u0642\u0641\u064a \u0627\u0644\u0631\u0633\u0645\u064a \u0623\u0648\u0631\u064a\u062f\u0648 \u0648\u0628\u0637\u0627\u0642\u0627\u062a \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0627\u0644\u0645\u062f\u0641\u0648\u0639\u0629 \u0623\u0648\u0631\u064a\u062f\u0648 \u0644\u0644\u0645\u0628\u064a\u0639\u064a\u0646 \u0648\u0627\u0644\u062c\u0633\u0645\u0627\u062a \u0648\u0634\u0631\u0643\u0627\u062a \u0627\u0644\u0623\u0639\u0645\u0627\u0644 \u0641\u064a \u062c\u0632\u0627\u0626\u0631 \u0627\u0644\u0639\u062c\u0645\u0631." },
      { "q": "\u0643\u064a\u0641 \u0623\u0637\u0644\u0628 \u0637\u0644\u0628\u0627\u064b\u061f", "a": "\u064a\u0645\u0643\u0646 \u0637\u0628\u0631 \u0627\u0644\u0637\u0644\u0628\u0627\u062a \u0639\u0646 \u0637\u0631\u064a\u0642 \u0627\u062a\u0635\u0627\u0644 \u0628\u0641\u0631\u064a\u0642 \u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a \u0623\u0648 \u0639\u0628\u0631 \u0645\u0645\u062b\u0644\u0643 \u0627\u0644\u0645\u0628\u064a\u0639 \u0627\u0644\u0645\u062e\u0635\u0635. \u0646\u0636\u0645\u0646 \u0645\u0639\u0627\u0644\u062c\u0629 \u0633\u0631\u064a\u0639\u0629 \u0644\u0644\u0637\u0644\u0628\u0627\u062a \u0648\u062a\u0648\u0636\u064a\u0639 \u0645\u0648\u062b\u0648\u0642 \u0644\u0644\u0645\u0646\u062a\u062c\u0627\u062a." },
      { "q": "\u0647\u0644 \u062a\u0642\u062f\u0645\u0648\u0646 \u0633\u0639\u0631 \u062c\u0633\u0645\u064a\u0627\u064b\u061f", "a": "\u0646\u0639\u0645\u060c \u0646\u0642\u062f\u0645 \u0633\u0639\u0631 \u062c\u0633\u0645\u064a\u0627\u064b \u0645\u0646\u0627\u0641\u0635\u064a\u064b \u0648\u062e\u064a\u0627\u0631\u0627\u062a \u0634\u0631\u0627\u0621 \u0645\u0631\u0646\u0635\u0629 \u0644\u0644\u0645\u0628\u064a\u0639\u064a\u0646 \u0648\u0627\u0644\u062c\u0633\u0645\u0627\u062a \u0648\u0645\u0648\u0627\u0642\u0639\u064a \u0627\u0644\u062a\u0648\u0638\u064a\u0641 \u0627\u0644\u0645\u062e\u0635\u0635\u064a\u0646 \u0628\u0646\u0627\u0621\u064b \u0639\u0644\u0649 \u062d\u062c\u0645 \u0627\u0644\u0637\u0644\u0628." },
      { "q": "\u0643\u064a\u0641 \u062a\u062a\u0635\u0644 \u0628\u0641\u0631\u064a\u0642 \u062f\u0639\u0645 \u0627\u0644\u0639\u0645\u0644\u0627\u0621\u061f", "a": "\u0641\u0631\u064a\u0642 \u0627\u0644\u062f\u0639\u0645 \u0645\u062a\u0627\u062d \u0644\u0645\u0633\u0627\u0639\u062f\u062a\u0643 \u0641\u064a \u062a\u0648\u0641\u0631 \u0627\u0644\u0645\u0646\u062a\u062c\u0627\u062a\u060c \u0627\u0644\u0637\u0644\u0628\u0627\u062a\u060c \u0634\u0631\u0643\u0627\u062a \u0627\u0644\u0645\u0628\u064a\u0639\u064a\u0646 \u0648\u062e\u062f\u0645\u0627\u062a \u0627\u0644\u062a\u0648\u0632\u064a\u0639. \u064a\u0645\u0643\u0646\u0643 \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0628\u0646\u0627 \u0639\u0628\u0631 \u0627\u0644\u0647\u0627\u062a\u0641\u060c \u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a \u0623\u0648 \u0639\u0628\u0631 \u0646\u0645\u0637\u0627\u0639 \u0627\u0644\u062a\u0648\u0627\u0635\u0644 \u0639\u0644\u0649 \u0645\u0648\u0642\u0639\u0646\u0627 \u0627\u0644\u0625\u0646\u062a\u0631\u0646\u062a." }
    ]
  },
