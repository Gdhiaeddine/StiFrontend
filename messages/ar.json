    "items": [
      { "name": "\u0623\u062d\u0645\u062f \u0628\u0646\u0627\u0644\u064a", "role": "\u0645\u0633\u0626\u0648\u0644 IT\u060c \u0633\u0648\u0646\u0627\u0637\u0631\u0634", "review": "\u0643\u0627\u0646\u062a STI \u0634\u0631\u064a\u0643\u0646\u0627 \u0641\u064a \u0627\u0644\u0627\u062a\u0635\u0627\u0644\u0627\u062a \u0627\u0644\u0645\u0646\u062e\u0635\u0635\u0629 \u0644\u0645\u0639\u062f\u0629 \u0623\u0643\u062b\u0631 \u0645\u0646 5 \u0633\u0646\u0648\u0627\u062a. \u062d\u0644\u0648\u0644 \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0627\u0644\u062a\u0643\u0646\u0648\u0644\u0648\u062c\u064a\u0629 \u0644\u062f\u064a\u0647\u0645 \u0645\u0645\u062a\u0627\u0632\u0629 \u0648\u0641\u0631\u064a\u0642 \u0627\u0644\u062f\u0639\u0645 \u064a\u0633\u062a\u062c\u064a\u0628 \u062f\u0627\u0626\u0645\u0627\u064b." },
      { "name": "\u0641\u0627\u0637\u0645\u0629 \u062d\u0627\u062c", "role": "\u0645\u0633\u0626\u0648\u0644 \u0627\u0644\u0639\u0645\u0644\u064a\u0627\u062a\u060c \u0633\u064a\u0641\u064a\u062a\u0627\u0644", "review": "\u062a\u062d\u0648\u064a\u0644 \u0625\u0644\u0649 STI \u0644\u0625\u062f\u0627\u0631\u0629 \u0628\u0637\u0627\u0642\u0627\u062a \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0644\u0623\u0633\u062a\u0644\u0648\u0646\u0627 \u0643\u0627\u0646 \u0646\u0642\u0637\u0629 \u062a\u062d\u0648\u064a\u0644. \u0646\u0638\u0627\u0645 \u0627\u0644\u062a\u062d\u0645\u064a\u0644 \u0627\u0644\u062c\u0633\u0645\u064a \u064a\u0648\u0641\u0631 \u0644\u0646\u0627 \u0633\u0627\u0639\u0627\u062a \u0643\u0644 \u0623\u0633\u0628\u0648\u0639 \u0648\u0627\u0644\u062a\u0642\u0631\u064a\u0631 \u0645\u0645\u062a\u0627\u0632." },
      { "name": "\u064a\u0648\u0633\u0641 \u0645\u0646\u0635\u0648\u0631\u064a", "role": "\u0627\u0644\u0645\u062f\u064a\u0631 \u0627\u0644\u062a\u0646\u0641\u064a\u0630\u064a\u060c TechStart \u0627\u0644\u062c\u0632\u0627\u0626\u0631", "review": "\u0643\u0634\u0631\u0643\u0629 \u062c\u062f\u064a\u062f\u0629\u060c \u0643\u0646\u0627 \u0646\u062d\u062a\u0627\u062c \u0625\u0644\u0649 \u0627\u062a\u0635\u0627\u0644 \u0645\u0631\u0646\u0635 \u0648\u0645\u0646\u0627\u0633\u0628. \u0642\u062f\u0645\u062a STI \u0628\u0630\u0644\u064b\u06a4 \u0628\u062d\u0632\u0645 \u0627\u0644\u0628\u0637\u0627\u0642\u0627\u062a \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629 \u0648\u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u062d\u0633\u0627\u0628\u0627\u062a \u0627\u0644\u0645\u062e\u0635\u0635\u0629." }
    ]
